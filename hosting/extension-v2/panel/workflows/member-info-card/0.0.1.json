{
  "workflowId": "member.info.show",
  "artifactId": "member-info-card",
  "artifactVersion": "0.0.1",
  "output": {
    "providerIdentity": "$steps.readPanelState.providerIdentityCache.providerIdentity",
    "settings": {
      "meetingWorkspaceTarget": "$steps.readPanelState.settings.meetingWorkspaceTarget"
    },
    "uiPreferences": {
      "activePromptTab": "$steps.readPanelState.uiPreferences.activePromptTab",
      "activeTool": "$steps.readPanelState.uiPreferences.activeTool",
      "panelOpen": "$steps.readPanelState.uiPreferences.panelOpen"
    }
  },
  "steps": [
    {
      "id": "readPanelState",
      "type": "bridge",
      "bridgeApi": "readPanelState",
      "input": {}
    },
    {
      "id": "emitTrace",
      "type": "bridge",
      "bridgeApi": "emitTrace",
      "input": {
        "channel": "member",
        "step": "member.info.workflow.read",
        "payload": {
          "capabilityId": "member.info.show"
        }
      }
    }
  ]
}
