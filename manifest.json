{
  "manifest_version": 3,
  "name": "아이노바 실험실",
  "version": "1.0.0",
  "description": "i-Nova 대화 화면에 패널과 프롬프트 도구를 더하는 크롬 확장입니다.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://inova.incross.com/*",
    "https://asia-northeast3-browser-extension-main.cloudfunctions.net/*",
    "https://browser-extension-main.web.app/*",
    "https://browser-extension-v2.web.app/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5001/*",
    "http://localhost:5001/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://browser-extension-main.web.app https://browser-extension-v2.web.app http://127.0.0.1:5000 http://localhost:5000"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "아이노바 실험실",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://inova.incross.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/product-lane.js",
        "shared/session.js",
        "shared/firebase-config.js",
        "shared/provider-identity.js",
        "shared/cloud-sync.js",
        "shared/storage.js",
        "shared/frame-proxy.js",
        "content/dom.js",
        "content/composer.js",
        "content/features/prompt-review/composer-review-float.js",
        "content/features/prompt-review/prompt-review-manager.js",
        "content/route-state-controller.js",
        "content/route-watch-controller.js",
        "content/route-sync.js",
        "content/hosted-panel-bridge.js",
        "content/panel-console-trace.js",
        "content/panel-host-runtime.js",
        "content/panel-host-bridge.js",
        "content/panel-host-view.js",
        "content/panel.js",
        "content/panel-v2-prompt-controller.js",
        "content/panel-v2-shell-bridge.js",
        "content/panel-v2-composition-controller.js",
        "content/main.js"
      ],
      "css": [
        "content/panel.css",
        "content/composer-review.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://browser-extension-main.web.app/meeting/*",
        "https://browser-extension-v2.web.app/meeting/*",
        "http://127.0.0.1/meeting/*",
        "http://localhost/meeting/*"
      ],
      "js": [
        "content/meeting-workspace-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/frame-proxy.html",
        "content/frame-proxy.js"
      ],
      "matches": [
        "https://inova.incross.com/*"
      ]
    }
  ]
}
