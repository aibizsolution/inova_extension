{
  "manifest_version": 3,
  "name": "아이노바 실험실",
  "version": "0.3.4",
  "description": "i-Nova 대화 화면에 패널과 프롬프트 도구를 더하는 크롬 확장입니다.",
  "permissions": [
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://inova.incross.com/*",
    "https://asia-northeast3-browser-extension-main.cloudfunctions.net/*",
    "https://browser-extension-main.web.app/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "아이노바 실험실",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://inova.incross.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/session.js",
        "shared/prompt-library.js",
        "shared/prompt-store.js",
        "shared/release-info.js",
        "shared/firebase-config.js",
        "shared/provider-identity.js",
        "shared/cloud-sync.js",
        "shared/storage.js",
        "content/dom.js",
        "content/composer.js",
        "content/files.js",
        "content/composer-review-float.js",
        "content/prompt-review-view.js",
        "content/bookmark-view.js",
        "content/prompt-view.js",
        "content/store-view.js",
        "content/prompt-hub-view.js",
        "content/release-view.js",
        "content/prompt-review-manager.js",
        "content/cloud-sync-manager.js",
        "content/route-sync.js",
        "content/prompt-manager.js",
        "content/store-manager.js",
        "content/release-manager.js",
        "content/panel.js",
        "content/main.js"
      ],
      "css": [
        "content/panel.css",
        "content/tools.css",
        "content/composer-review.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
