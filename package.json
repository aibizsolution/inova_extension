{
  "name": "inova-session-bookmarks",
  "version": "0.3.4",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "hooks:install": "node scripts/install-git-hooks.js",
    "deploy:hosting": "npm run release:build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:all": "npm run release:build && firebase deploy --only hosting,functions",
    "release:build": "node scripts/build-release-package.js",
    "release:deploy": "npm run deploy:hosting",
    "version:bump": "node scripts/bump-version.js",
    "check:cloud-sync": "node scripts/check-cloud-sync.js",
    "check:function-logs": "node scripts/check-function-logs.js",
    "cleanup:branches": "node scripts/cleanup-local-branches.js",
    "rebuild:store-feeds": "node scripts/rebuild-store-feeds.js",
    "seed:business-store": "node scripts/seed-business-store.js",
    "seed:business-store:dry": "node scripts/seed-business-store.js --dry-run",
    "seed:system-store": "node scripts/seed-system-store.js",
    "seed:system-store:dry": "node scripts/seed-system-store.js --dry-run",
    "seed:store:all": "npm run seed:system-store && npm run seed:business-store",
    "seed:store:all:dry": "npm run seed:system-store:dry && npm run seed:business-store:dry",
    "verify": "node scripts/verify-contracts.js && node scripts/verify-docs.js",
    "verify:branch-guard": "node scripts/verify-branch-workflow.js --pre-commit",
    "verify:contracts": "node scripts/verify-contracts.js",
    "verify:docs": "node scripts/verify-docs.js",
    "verify:readme-guard": "node scripts/verify-readme-update.js --staged",
    "verify:release-guard": "node scripts/verify-release-metadata.js --staged"
  }
}
