# INOVA_EXTENSION_OPENAI_API_KEY is an i-Nova-only Secret Manager secret in production.
# For local emulator runs, copy functions/.secret.local.example to functions/.secret.local.
OPENAI_PROMPT_REVIEW_MODEL=gpt-5.4-mini
OPENAI_MEETING_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENROUTER_PROMPT_REVIEW_MODEL=openai/gpt-5.4-mini
OPENROUTER_MEETING_SUMMARY_MODEL=openai/gpt-5.5
OPENROUTER_MEETING_TRANSCRIBE_MODEL=openai/gpt-4o-transcribe
GEMINI_MEETING_SUMMARY_MODEL=gemini-3.1-pro-preview
GEMINI_MEETING_TRANSCRIBE_MODEL=gemini-3.5-flash
GEMINI_MEETING_TRANSCRIBE_THINKING_LEVEL=minimal
GEMINI_MEETING_TRANSCRIBE_MAX_OUTPUT_TOKENS=16384
OPENAI_MEETING_INLINE_AUDIO_LIMIT_BYTES=20971520
OPENAI_MEETING_SOURCE_TARGET_PART_BYTES=20971520
OPENAI_MEETING_SOURCE_MAX_BYTES=209715200
OPENAI_MEETING_SOURCE_MAX_DURATION_MS=7200000
OPENAI_MEETING_SPEAKER_RECONCILE_MODEL=gpt-5.4-mini
# Optional: pin a fixed per-job chunk concurrency instead of the adaptive 1~5 default.
# OPENAI_MEETING_CHUNK_TRANSCRIPTION_CONCURRENCY=5
# Optional: retry retryable 429/5xx meeting processing errors up to this many times.
# OPENAI_MEETING_PROCESS_RETRY_LIMIT=2
# Optional: override the Firebase app storage bucket used for temporary meeting audio.
# Leave unset in production so Functions uses FIREBASE_CONFIG.storageBucket.
# Never point this at gcf-v2-* Cloud Functions deployment buckets.
# STORAGE_BUCKET_URL=your-project.firebasestorage.app
INOVA_AUTH_SIGNING_SERVICE_ACCOUNT=1027279095019-compute@developer.gserviceaccount.com
