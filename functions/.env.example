OPENAI_API_KEY=your_openai_api_key_here
OPENAI_PROMPT_REVIEW_MODEL=gpt-5.4-mini
OPENAI_MEETING_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_MEETING_INLINE_AUDIO_LIMIT_BYTES=20971520
OPENAI_MEETING_SOURCE_TARGET_PART_BYTES=20971520
OPENAI_MEETING_SOURCE_MAX_BYTES=209715200
OPENAI_MEETING_SOURCE_MAX_DURATION_MS=7200000
OPENAI_MEETING_SPEAKER_RECONCILE_MODEL=gpt-5.4-mini
# Optional: pin a fixed per-job chunk concurrency instead of the adaptive 1~5 default.
# OPENAI_MEETING_CHUNK_TRANSCRIPTION_CONCURRENCY=5
# Optional: retry retryable 429/5xx meeting processing errors up to this many times.
# OPENAI_MEETING_PROCESS_RETRY_LIMIT=2
STORAGE_BUCKET_URL=gcf-v2-uploads-1027279095019.asia-northeast3.cloudfunctions.appspot.com
FIREBASE_AUTH_SIGNING_SERVICE_ACCOUNT=1027279095019-compute@developer.gserviceaccount.com
