rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isLegacyWorkspaceSessionActive() {
      return request.auth != null
        && request.auth.token.scope == "meeting-workspace"
        && request.time.toMillis() < request.auth.token.workspaceExpMs;
    }

    function isOwnerWorkspaceSessionActive() {
      return request.auth != null
        && (
          request.auth.token.scope == "meeting-workspace-owner"
          || isLegacyWorkspaceSessionActive()
        );
    }

    function isShareWorkspaceSessionActive() {
      return request.auth != null
        && request.auth.token.scope == "meeting-workspace-share";
    }

    function isWorkspaceSessionActive() {
      return isOwnerWorkspaceSessionActive() || isShareWorkspaceSessionActive();
    }

    function workspaceOwnerProviderUserKey() {
      return request.auth != null
        ? (
          request.auth.token.ownerProviderUserKey != null
            ? request.auth.token.ownerProviderUserKey
            : request.auth.token.providerUserKey
        )
        : "";
    }

    function matchesMeetingWorkspace(resourceData) {
      return isWorkspaceSessionActive()
        && resourceData.owner.providerUserKey == workspaceOwnerProviderUserKey()
        && resourceData.meetingId == request.auth.token.meetingId;
    }

    function matchesMeetingWorkspaceDoc(docId) {
      return isWorkspaceSessionActive()
        && docId == workspaceOwnerProviderUserKey() + "__" + request.auth.token.meetingId
        && (
          resource == null
          || (
            resource.data.owner.providerUserKey == workspaceOwnerProviderUserKey()
            && resource.data.meetingId == request.auth.token.meetingId
          )
        );
    }

    function isPanelSessionActive() {
      return request.auth != null
        && request.auth.token.scope == "meeting-panel"
        && request.time.toMillis() < request.auth.token.panelExpMs;
    }

    function isPromptPanelSessionActive() {
      return request.auth != null
        && request.auth.token.scope == "prompt-panel"
        && request.time.toMillis() < request.auth.token.promptPanelExpMs;
    }

    function isPromptPanelV2SessionActive() {
      return request.auth != null
        && request.auth.token.scope == "prompt-panel-v2"
        && request.time.toMillis() < request.auth.token.promptPanelExpMs;
    }

    function isAnyPromptPanelSessionActive() {
      return isPromptPanelSessionActive() || isPromptPanelV2SessionActive();
    }

    function isHostedPanelSessionActive() {
      return isPanelSessionActive() || isPromptPanelV2SessionActive();
    }

    function matchesMeetingPanel(resourceData) {
      return isHostedPanelSessionActive()
        && resourceData.owner.providerUserKey == request.auth.token.providerUserKey;
    }

    function matchesMeetingParticipationPanel(resourceData) {
      return isHostedPanelSessionActive()
        && resourceData.viewer.providerUserKey == request.auth.token.providerUserKey;
    }

    function matchesOwnUsageMonthDoc(docId) {
      return isHostedPanelSessionActive()
        && docId.matches('^' + request.auth.token.providerUserKey + '__[0-9]{4}-[0-9]{2}$');
    }

    match /integration_inova_meetings/{docId} {
      allow get: if matchesMeetingWorkspaceDoc(docId) || (resource != null && matchesMeetingPanel(resource.data));
      allow list: if matchesMeetingPanel(resource.data);
      allow write: if false;
    }

    match /integration_inova_meeting_participations/{docId} {
      allow get: if matchesMeetingParticipationPanel(resource.data);
      allow list: if matchesMeetingParticipationPanel(resource.data);
      allow write: if false;
    }

    match /integration_inova_meeting_jobs/{jobId} {
      allow get: if matchesMeetingWorkspace(resource.data);
      allow list: if false;
      allow write: if false;
    }

    match /integration_inova_meeting_artifacts/{artifactId} {
      allow get: if matchesMeetingWorkspace(resource.data);
      allow list: if false;
      allow write: if false;
    }

    match /integration_inova_meeting_usage_user_months/{docId} {
      allow get: if matchesOwnUsageMonthDoc(docId);
      allow list: if false;
      allow write: if false;
    }

    match /integration_inova_meeting_usage_user_totals/{providerUserKey} {
      allow get: if isHostedPanelSessionActive()
        && request.auth.token.providerUserKey == providerUserKey;
      allow list: if false;
      allow write: if false;
    }

    match /integration_inova_meeting_usage_events/{docId} {
      allow read, write: if false;
    }

    match /integration_inova_meeting_usage_admin_months/{docId} {
      allow read, write: if false;
    }

    match /integration_inova_meeting_usage_admin_days/{docId} {
      allow read, write: if false;
    }

    match /integration_inova_feature_usage_client_days/{docId} {
      allow read, write: if false;
    }

    match /integration_inova_feature_usage_user_days/{docId} {
      allow read, write: if false;
    }

    match /integration_inova_feature_usage_user_months/{docId} {
      allow read, write: if false;
    }

    match /integration_inova_feature_usage_admin_days/{docId} {
      allow read, write: if false;
    }

    match /integration_inova_feature_usage_admin_months/{docId} {
      allow read, write: if false;
    }

    match /integration_inova_accounts/{providerUserKey} {
      allow get: if isPromptPanelSessionActive()
        && request.auth.token.providerUserKey == providerUserKey;
      allow list: if false;
      allow write: if false;
    }

    match /integration_inova_accounts_v2/{providerUserKey} {
      allow get: if isPromptPanelV2SessionActive()
        && request.auth.token.providerUserKey == providerUserKey;
      allow list: if false;
      allow write: if false;
    }

    match /prompt_library_orders/{libraryId} {
      allow get: if isPromptPanelSessionActive()
        && request.auth.token.promptLibraryId == libraryId
        && (
          resource == null
          || resource.data.libraryId == request.auth.token.promptLibraryId
        );
      allow list: if false;
      allow write: if false;
    }

    match /prompt_library_orders_v2/{libraryId} {
      allow get: if isPromptPanelV2SessionActive()
        && request.auth.token.promptLibraryId == libraryId
        && (
          resource == null
          || resource.data.libraryId == request.auth.token.promptLibraryId
        );
      allow list: if false;
      allow write: if false;
    }

    match /prompt_library_chunks/{docId} {
      allow get: if isPromptPanelSessionActive()
        && (
          docId.matches('^' + request.auth.token.promptLibraryId + '__b[0-9]{2}$')
          || (
            resource != null
            && resource.data.libraryId == request.auth.token.promptLibraryId
          )
        );
      allow list: if false;
      allow write: if false;
    }

    match /prompt_library_chunks_v2/{docId} {
      allow get: if isPromptPanelV2SessionActive()
        && (
          docId.matches('^' + request.auth.token.promptLibraryId + '__b[0-9]{2}$')
          || (
            resource != null
            && resource.data.libraryId == request.auth.token.promptLibraryId
          )
        );
      allow list: if false;
      allow write: if false;
    }

    match /prompt_store_meta/{docId} {
      allow get: if isAnyPromptPanelSessionActive() && docId == "summary";
      allow list: if false;
      allow write: if false;
    }

    match /prompt_store_feed_pages/{docId} {
      allow get: if isAnyPromptPanelSessionActive()
        && docId.matches('^latest__all__000[0-1]$');
      allow list: if false;
      allow write: if false;
    }

    match /prompt_store_entries/{entryId} {
      allow get: if isAnyPromptPanelSessionActive()
        && resource.data.status == "published";
      allow list: if isAnyPromptPanelSessionActive()
        && request.query.limit != null
        && request.query.limit <= 1000
        && resource.data.status == "published";
      allow write: if false;
    }

    match /prompt_store_entry_details/{entryId} {
      allow get: if isAnyPromptPanelSessionActive()
        && exists(/databases/$(database)/documents/prompt_store_entries/$(entryId))
        && get(/databases/$(database)/documents/prompt_store_entries/$(entryId)).data.status == "published";
      allow list: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
